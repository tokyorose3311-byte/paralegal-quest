# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/*
!/build/web
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node dependencies for Netlify Functions (Netlify installs these automatically
# from the root package.json/package-lock.json during deploy)
/node_modules/

# Firebase service account keys -- NEVER commit these, they grant full admin
# access to the Firebase project. Used locally only by one-off scripts like
# scripts/bulk_upload/bulk_upload_questions.js.
serviceAccountKey.json
**/serviceAccountKey.json
